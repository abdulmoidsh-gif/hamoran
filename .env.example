# ══════════════════════════════════════════════════════
# HAMORAN SECURE BACKEND — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════

# ── SERVER ──────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── ADMIN CREDENTIALS ───────────────────────────────
# Generate bcrypt hash: node -e "const b=require('bcryptjs');console.log(b.hashSync('YOUR_PASSWORD',12))"
# NEVER store the plaintext password here — only the bcrypt hash
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_ACTUAL_BCRYPT_HASH_OF_YOUR_PASSWORD

# ── JWT SECRETS (generate with: node -e "require('crypto').randomBytes(64).toString('hex')" ) ──
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_RANDOM_HEX_STRING

# ── JWT EXPIRY ───────────────────────────────────────
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── CSRF ─────────────────────────────────────────────
CSRF_SECRET=REPLACE_WITH_32_BYTE_RANDOM_HEX_STRING

# ── CORS (comma-separated list of allowed origins) ───
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── WHATSAPP / CONTACT ───────────────────────────────
# These are NOT credentials — just contact info used server-side
WA_NUMBER=447404829923
CONTACT_EMAIL=your-contact@email.com

# ── RATE LIMITING ────────────────────────────────────
# Set REDIS_URL for production multi-instance rate limiting
# Leave empty to use in-memory store (single instance only)
REDIS_URL=

# ── HTTPS ────────────────────────────────────────────
# Set to true in production to enforce HTTPS redirect
FORCE_HTTPS=true

# ── HSTS ─────────────────────────────────────────────
HSTS_MAX_AGE=31536000
