{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/admin.html", "dest": "/public/admin.html" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*\\.(css|js|png|ico|svg|woff2|woff|ttf))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
